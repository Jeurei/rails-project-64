ruby:
  field_name = local_assigns[:field_name]
  form_object = f.object
  has_error = form_object && form_object.errors[field_name].any?
  input_class = "form-control #{has_error ? 'is-invalid' : ''}"

= f.input field_name,
  label: local_assigns[:label],
  autofocus: local_assigns[:autofocus] || false,
  as: local_assigns[:as] || :string,
  placeholder: local_assigns[:placeholder] || '',
  input_html: local_assigns[:input_html] || { class: input_class },
  wrapper_html: local_assigns[:wrapper_html] || { class: has_error ? 'form-group has-error' : 'form-group' },
  label_html: local_assigns[:label_html] || { class: 'form-label' },
  error_html: { class: 'invalid-feedback text-danger' },
  error: has_error ? form_object.errors[field_name].first : false
