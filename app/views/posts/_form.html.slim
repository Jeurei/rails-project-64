= simple_form_for post do |form|
  - if post.errors.any?
    div style="color: red"
      h2 = pluralize(post.errors.count, "error") + " prohibited this post from being saved:"
      ul
        - post.errors.each do |error|
          li = error.full_message
  .form-group.row.gap-2.mb-2
    = render "shared/inputs/text_input", f: form, field_name: :title, autocomplete: "title", autofocus: true
    = form.association :category, collection: @categories, include_blank: true, input_html: { class: "form-control" }
    = render "shared/inputs/text_input", f: form, field_name: :body, as: :text, autocomplete: "body", autofocus: true
  .form-actions
    = render "shared/inputs/submit", f: form, text: "Создать пост"
