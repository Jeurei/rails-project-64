header
  nav.d-flex.flex-wrap.align-items-center.py-2.border-bottom.justify-content-between
    div.navbar.navbar-expand-md.navbar-light
      = link_to root_path, { class: "navbar-brand me-md-4" }
          img src = "/assets/logo.jpg" alt="Logo" width="30"
    - if user_signed_in?
      = link_to "Выйти", destroy_user_session_path, data: { turbo_method: :delete }
    - else
      ul.nav.nav-pills
        li.nav-item.me-2
          = link_to "Войти", new_user_session_path, { class: "nav-link link-dark" }
        li.nav-item.me-2
          = link_to "Зарегистрироваться", new_user_registration_path, { class: "nav-link link-dark" }
