= simple_form_for comment, url: post_comments_path(post) do |f|
  = f.error_notification

  .row.gap-4
    .form-inputs
      = render 'shared/inputs/text_input',
               f: f,
               as: :text,
               field_name: :content,
               label: false,
               autocomplete: 'content',
               autofocus: true,
               placeholder: t('.placeholder')

    .form-actions
      = render 'shared/inputs/submit', f: f, text: t('.submit')
